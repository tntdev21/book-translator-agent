# flutter
.dart_tool
build
GoogleService-Info.plist

repomix-output.xml
.serena/cache
screenshots/*
docs/screenshots/*
docs/journals/*
docs/research/*
logs.txt
test-ck
__pycache__
prompt.md

# Gemini CLI settings (symlink to .claude/.mcp.json)
.gemini/settings.json
.claude/settings.bak.json
.venv
venv/
activate.sh.bak
.DS_Store

# --- translation pipeline ---
# Per-book build artifacts. Book content (source/chunks/translated/style) is
# tracked; exports are regenerable.
books/*/output/
output/document*
# Backups created by fix scripts
*.bak
# CJK / quality reports
logs/
webapp.zip.part*

# Term-cleanup scratch output (book style/)
**/new_terms_deduped.txt
**/new_terms_standardized.txt

# Claude Code hook logs (runtime, regenerated)
.claude/hooks/.logs/

# Local rollback backups
backups/

# Editor verdict files (runtime, per batch)
books/*/review/
